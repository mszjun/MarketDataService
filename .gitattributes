# Default: detect text files and normalize to LF in the repository.
* text=auto eol=lf

# C/C++ / CMake / docs / config
*.c      text eol=lf
*.cc     text eol=lf
*.cpp    text eol=lf
*.h      text eol=lf
*.hpp    text eol=lf
*.cmake  text eol=lf
CMakeLists.txt text eol=lf
*.md     text eol=lf
*.json   text eol=lf
*.sql    text eol=lf
*.yml    text eol=lf
*.yaml   text eol=lf
*.sh     text eol=lf

# Windows scripts must keep CRLF
*.cmd    text eol=crlf
*.bat    text eol=crlf
*.ps1    text eol=crlf

# Binary / vendored archives: never normalize or diff as text
*.zip    binary
*.7z     binary
*.tar    binary
*.gz     binary
*.lib    binary
*.dll    binary
*.so     binary
*.exe    binary
*.png    binary
*.jpg    binary
*.ico    binary

# Keep the vendored CTP headers (GBK encoded) and third-party archives intact
third_party/** linguist-vendored
