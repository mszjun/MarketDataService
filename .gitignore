/build/
/out/
CMakeCache.txt
CMakeFiles/
cmake_install.cmake
Makefile
*.ninja
.ninja_deps
.ninja_log
compile_commands.json
CMakeUserPresets.json
CTestTestfile.cmake
Testing/

# Compiled objects / libraries / executables
*.o
*.obj
*.lo
*.a
*.lib
*.exp
*.exe
*.dll
*.so
*.so.*
*.dylib
*.pdb
*.ilk
*.idb
*.map

