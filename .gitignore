# ---------------------------------------------------------------------------
# Runtime data (created next to the executable)
# ---------------------------------------------------------------------------
/logs/*
!/logs/.gitkeep
/MarketDataFlow/
/marketdata_*/
*.log
*.log.*
startup.log

# Generated instrument cache: fetched at startup, never hand-edited
/config/instruments_cache.json

# Optional pre-extracted dependencies (CMake prefers these over the archives)
/third_party/asio/
/third_party/ctp/

